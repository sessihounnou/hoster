# ============================================================
# Copier ce fichier en .env et remplir toutes les valeurs
# ============================================================

# Serveur
PORT=3000
NODE_ENV=production
JWT_SECRET=changeme_remplacez_par_une_chaine_aleatoire_longue
APP_URL=https://api.votredomaine.com
FRONTEND_URL=https://votredomaine.com

# FedaPay
FEDAPAY_SECRET_KEY=sk_live_xxxx
FEDAPAY_ENV=live

# IP publique du serveur host (affichée aux clients en mode port forwarding)
SERVER_PUBLIC_IP=212.47.78.8

# Contabo API — IPs dédiées par VPS (laisser vide pour utiliser le mode port forwarding)
# Récupérer sur https://my.contabo.com/api/details
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
CONTABO_INSTANCE_ID=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@votredomaine.com
SMTP_PASS=votre_mot_de_passe_smtp
SMTP_FROM="Mon Hébergeur VPS <contact@votredomaine.com>"

# Admin créé au premier démarrage (changer après la première connexion)
ADMIN_EMAIL=admin@votredomaine.com
ADMIN_PASSWORD=changeme_admin_password

# Clé de chiffrement AES pour les mots de passe VPS en DB (32 caractères hex)
ENCRYPTION_KEY=changeme_32_chars_hex_encryption_key_here
